# Kraken API credentials
# Needed for authenticated endpoints (order placement, account queries) in later PRs.
# PR 1 uses only public, unauthenticated Kraken endpoints - these are not read yet.
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_api_secret_here

# Alert webhook (Slack / Discord / PagerDuty) - wired up in a future PR
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional overrides (uncomment to change defaults used by scripts)
# TRADING_PAIR=XBTUSD
# OHLCV_INTERVAL=15
# OHLCV_DB_PATH=data/ohlcv.sqlite
